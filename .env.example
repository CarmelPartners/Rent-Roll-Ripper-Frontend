# Base URL for the Python Functions API.
# Leave blank to use the Vite dev proxy (/api -> http://localhost:7071).
VITE_API_BASE_URL=

# Local-dev-only Okta bypass. When true, skips the "Sign in with Okta" screen
# entirely — the backend must ALSO have LOCAL_DEV_BYPASS_AUTH=true set in its
# local.settings.json for this to actually work end to end (the frontend flag
# alone just skips the login prompt; the backend flag is what makes /api/auth/me
# succeed without a real bearer token). Never set this in a deployed build —
# copy this file to .env.local (gitignored) rather than editing this example.
VITE_LOCAL_DEV_BYPASS_AUTH=false
